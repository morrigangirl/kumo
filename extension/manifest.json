{
  "manifest_version": 3,
  "name": "Kumo",
  "version": "0.1.0",
  "description": "Your local start page, themes, search engines, and opt-in browser agents.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "nativeMessaging",
    "activeTab",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_page": "newtab.html#settings",
  "action": {
    "default_title": "Kumo \u00b7 Agent access",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chromewebstore.google.com/*"
      ],
      "js": [
        "store.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; img-src 'self' data: blob:; connect-src 'self'"
  },
  "key": ""
}
