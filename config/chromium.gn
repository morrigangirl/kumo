# Kumo's overlay, merged after the two pinned upstream GN configurations.
# Keep Chromium's engine executable/framework names for the native launcher.
is_chrome_branded = false
is_component_build = false
is_debug = false
is_official_build = true
target_cpu = "arm64"
# Conservative first build for the development Mac's 24 GB memory.
chrome_pgo_phase = 0
use_thin_lto = false
# Verified LLVM23 linker handles SDK27 TAPI and existing DWARF unwind entries.
# The immutable path binds generated links to the locked binary SHA256.
use_lld = true
lld_path = "//third_party/kumo-lld/23.1.3-edde6ab11fb5258006ae0493ccaa3112c1a547aac36fe75c0317fb0ec559adea/bin"
# Preserve the prior no-deduplication behavior during this linker-only repair.
use_icf = false
symbol_level = 0
blink_symbol_level = 0
# No Google browser identity, sync keys, reporting, or Google updater.
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
use_official_google_api_keys = false
enable_reporting = false
enable_updater = false
# Upstream patches remove Safe Browsing. Changing this flag alone cannot restore it.
safe_browsing_mode = 0
