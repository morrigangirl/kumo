{
  "manifest_version": 3,
  "name": "Kumo PhishLang",
  "version": "0.1.0",
  "description": "Experimental, opt-in phishing warnings using a local PhishLang model on your Mac.",
  "minimum_chrome_version": "124",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "nativeMessaging",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "settings.html",
  "action": {
    "default_title": "Kumo PhishLang \u00b7 Local phishing warnings",
    "default_popup": "settings.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self'; img-src 'self' data:;"
  },
  "key": ""
}
