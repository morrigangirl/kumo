#!/bin/sh
# Every distributed invocation uses its own bundled runtime, independent of PATH.
set -eu
case "$0" in */*) kumo_parent=${0%/*} ;; *) exit 69 ;; esac
kumo_server=$(CDPATH= cd -P -- "$kumo_parent" && pwd)
unset NODE_OPTIONS NODE_PATH KUMO_AGENT_DIR
kumo_node="$kumo_server/bin/node"
if [ ! -x "$kumo_node" ]; then
  printf '%s\n' 'Kumo agent runtime is missing. Reinstall Kumo to repair it.' >&2
  exit 69
fi
exec "$kumo_node" --jitless --no-expose-wasm "$kumo_server/cli.mjs" "$@"
